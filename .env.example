# Environment Variables Template
# Copy this file to .env.local for development

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chess.com API (public API, no key needed)
# Rate limit: respect Chess.com's fair use policy

# Stockfish Configuration
NEXT_PUBLIC_STOCKFISH_DEPTH=18
NEXT_PUBLIC_STOCKFISH_THREADS=1

# Optional: Database (untuk caching analysis results di future)
# DATABASE_URL=postgresql://user:password@localhost:5432/chess_analysis
# REDIS_URL=redis://localhost:6379

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=
